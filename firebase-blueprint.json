{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with role-based access information",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User full name"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar image URL"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "student"],
          "description": "User role (admin for legialoi@gmail.com, student for others)"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of registration"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "ISO timestamp of last login"
        }
      },
      "required": ["uid", "email", "role"]
    },
    "StudentSubmission": {
      "title": "Student Code Submission & Audit Record",
      "description": "Audit record saved for student submissions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Audit document ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner student UID"
        },
        "userEmail": {
          "type": "string",
          "description": "Owner student email"
        },
        "studentName": {
          "type": "string",
          "description": "Student name"
        },
        "fileName": {
          "type": "string",
          "description": "Submitted C++ file name"
        },
        "code": {
          "type": "string",
          "description": "C++ code snippet"
        },
        "aiRiskLevel": {
          "type": "string",
          "enum": ["Thấp", "Trung bình", "Cao", "Rất cao"],
          "description": "AI Risk Level"
        },
        "aiRiskScore": {
          "type": "number",
          "description": "AI Risk Score percentage"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of submission"
        }
      },
      "required": ["userId", "studentName", "aiRiskLevel", "aiRiskScore"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User account document containing role and profile"
    },
    "/submissions/{submissionId}": {
      "schema": "StudentSubmission",
      "description": "Audit results saved by students or teacher"
    }
  }
}
