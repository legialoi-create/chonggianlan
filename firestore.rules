rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == "legialoi@gmail.com";
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'lastLoginAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 254 &&
             data.role in ['admin', 'student'] &&
             // Role can only be admin if the verified email is legialoi@gmail.com
             (data.role != 'admin' || request.auth.token.email == 'legialoi@gmail.com');
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['userId', 'studentName', 'aiRiskLevel', 'aiRiskScore']) &&
             data.keys().hasOnly(['id', 'userId', 'userEmail', 'studentName', 'fileName', 'code', 'aiRiskLevel', 'aiRiskScore', 'createdAt']) &&
             data.userId is string && (data.userId == request.auth.uid || isAdmin()) &&
             data.studentName is string && data.studentName.size() <= 200 &&
             data.aiRiskLevel in ['Thấp', 'Trung bình', 'Cao', 'Rất cao'] &&
             data.aiRiskScore is number && data.aiRiskScore >= 0 && data.aiRiskScore <= 100;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                    request.resource.data.uid == resource.data.uid &&
                    request.resource.data.email == resource.data.email &&
                    // Student cannot promote themselves to admin
                    (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();
    }

    // Student Submissions & Audits
    match /submissions/{submissionId} {
      allow get: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidSubmission(request.resource.data);
      allow update: if isVerifiedUser() && (isAdmin() || (resource.data.userId == request.auth.uid && isValidSubmission(request.resource.data) && request.resource.data.userId == resource.data.userId));
      allow delete: if isAdmin() || (isVerifiedUser() && resource.data.userId == request.auth.uid);
    }
  }
}
